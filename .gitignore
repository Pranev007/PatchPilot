# Ignore working runs, but keep the one published run whose artifacts back
# the numbers in the README. Must be `runs/*` and not `runs/` -- git does
# not descend into an ignored directory, so a negation inside one never
# matches.
runs/*
!runs/published/
.venv/
__pycache__/
*.pyc
.env
*.egg-info/
.pytest_cache/
