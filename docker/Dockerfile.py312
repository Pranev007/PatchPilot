# Sandbox image for the full benchmark run.
#
#   docker build -t migration-agent:py312 -f docker/Dockerfile.py312 .
#
# Ships uv plus both interpreters the benchmark needs, so `uv venv --python`
# does not have to download one per repo. Add build deps here as you discover
# repos that need them -- but if a repo needs an unusual system library, that
# is usually a signal to drop it from the benchmark rather than to widen this
# image.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        build-essential \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Pre-fetch the interpreters so per-repo setup does not pay the download.
RUN uv python install 3.8 3.12

# Runs as a non-root user: repo build scripts execute arbitrary code, and
# root in a container is one misconfiguration away from root on the host.
RUN useradd --create-home --shell /bin/bash runner
USER runner

WORKDIR /work
